# Required: people search.
EXA_API_KEY=your-exa-api-key-here

# Optional: email discovery and verification (only needed with --emails).
HUNTER_API_KEY=your-hunter-api-key-here
ZEROBOUNCE_API_KEY=your-zerobounce-api-key-here

# Optional: Google Sheet sender bridge (bridge.py --push). Web app URL and token from the Apps Script deployment.
SHEET_WEBAPP_URL=
SHEET_WEBAPP_TOKEN=
